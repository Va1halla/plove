{
    "label" : "lock",
    "action" : "{{ apps.lock | default(value="pidof hyprlock || hyprlock") }}",
    "text" : "Заблокировать",
    "keybind" : "l"
}
{
    "label" : "logout",
    "action" : "{{ hyprctl.exit }}",
    "text" : "Выйти",
    "keybind" : "e"
}
{
    "label" : "reboot",
    "action" : "systemctl reboot",
    "text" : "Перезагрузить",
    "keybind" : "r"
}
{
    "label" : "shutdown",
    "action" : "systemctl poweroff",
    "text" : "Выключить",
    "keybind" : "s"
}
