# Сгенерировано plove из райса «{{ name }}».
# Этот файл перезаписывается при каждом `plove apply`.
# Свои настройки пишите в ~/.config/hypr/user.conf, plove его не трогает.

{% for monitor in options.monitors -%}
{% if monitor is string -%}
monitor = {{ monitor }}
{% else -%}
{# right/left/above/below → auto-right/… Hyprland ставит монитор вплотную с этой стороны. -#}
{% set position = monitor.position | default(value="right") -%}
{% if position == "right" %}{% set position = "auto-right" -%}
{% elif position == "left" %}{% set position = "auto-left" -%}
{% elif position == "above" %}{% set position = "auto-up" -%}
{% elif position == "below" %}{% set position = "auto-down" %}{% endif -%}
{% set rotate = monitor.rotate | default(value=0) -%}
monitor = {{ monitor.name }}, {{ monitor.mode | default(value="preferred") }}, {{ position }}, {{ monitor.scale | default(value=options.scale) }}{% if rotate != 0 %}, transform, {{ rotate / 90 | round }}{% endif %}
{% endif -%}
{% endfor -%}
monitor = , preferred, auto, {{ options.scale }}
{% if vm == "vmware" %}
# VMware: 3D-драйвер виртуалки ломает OpenGL-программы (kitty падает
# с «unknown object … attach»). Пусть они рисуют программно.
env = LIBGL_ALWAYS_SOFTWARE,1
{% endif %}
# Переменные окружения от модулей: тема Qt, курсор и т. д.
{% for line in session_env -%}
env = {{ line }}
{% endfor -%}
# Фоновые программы: обои, панель, уведомления и т. д. (autostart в module.yaml).
{% for command in autostart -%}
exec-once = {{ command }}
{% endfor %}
general {
    gaps_in = {{ geometry.gaps_in }}
    gaps_out = {{ geometry.gaps }}
    border_size = {{ geometry.border }}
    col.active_border = rgb({{ colors.accent.raw }})
    col.inactive_border = rgb({{ colors.surface.raw }})
    layout = dwindle
}

decoration {
    rounding = {{ geometry.radius }}
    active_opacity = {{ geometry.opacity }}
    inactive_opacity = {{ geometry.opacity_inactive }}

    blur {
        enabled = true
        size = 6
        passes = 2
        popups = true
    }

    shadow {
        enabled = {{ options.shadows }}
        range = 18
        render_power = 3
        color = rgba({{ colors.bg.raw }}cc)
    }
}

# Размытие под панелью, лаунчером, уведомлениями и меню выхода.
layerrule = blur, waybar
layerrule = blur, launcher
layerrule = blur, rofi
layerrule = blur, swaync-control-center
layerrule = blur, swaync-notification-window
layerrule = blur, notifications
layerrule = blur, logout_dialog
layerrule = ignorezero, waybar
layerrule = ignorezero, rofi
layerrule = ignorezero, launcher

animations {
{%- if options.animations == "none" %}
    enabled = false
{%- else %}
{%- if options.animations == "smooth" %}{% set speed = 6 %}{% else %}{% set speed = 3 %}{% endif %}
    enabled = true
    bezier = ease, 0.25, 0.1, 0.25, 1.0
    animation = windows, 1, {{ speed }}, ease, popin 85%
    animation = fade, 1, {{ speed }}, ease
    bezier = overshot, 0.05, 0.9, 0.1, 1.05
    animation = layers, 1, {{ speed }}, overshot, popin 90%
    animation = border, 1, {{ speed * 2 }}, ease
    animation = workspaces, 1, {{ speed }}, ease, {{ options.workspace_animation }}
{%- endif %}
}

input {
    kb_layout = {{ options.kb_layout }}
    kb_options = {{ options.kb_options }}
    follow_mouse = 1
}

$mod = SUPER

# Клавиши программ: каждый модуль приносит свои (binds в module.yaml).
{% for bind in binds -%}
bind = {{ bind }}
{% endfor -%}
bind = $mod, Q, killactive,
{% if not apps.power %}bind = $mod SHIFT, E, exit,
{% endif -%}
bind = $mod, V, togglefloating,
bind = $mod, F, fullscreen,

bind = $mod, left, movefocus, l
bind = $mod, right, movefocus, r
bind = $mod, up, movefocus, u
bind = $mod, down, movefocus, d
# Окно — в сторону (и на соседний монитор, сверху/снизу тоже), рабочий стол — на монитор.
bind = $mod SHIFT, left, movewindow, l
bind = $mod SHIFT, right, movewindow, r
bind = $mod SHIFT, up, movewindow, u
bind = $mod SHIFT, down, movewindow, d
bind = $mod CTRL, left, movecurrentworkspacetomonitor, l
bind = $mod CTRL, right, movecurrentworkspacetomonitor, r
bind = $mod CTRL, up, movecurrentworkspacetomonitor, u
bind = $mod CTRL, down, movecurrentworkspacetomonitor, d
{% for i in range(start=1, end=10) %}
bind = $mod, {{ i }}, workspace, {{ i }}
bind = $mod SHIFT, {{ i }}, movetoworkspace, {{ i }}
{%- endfor %}

# Громкость, яркость и музыка с мультимедийных клавиш.
# bindel — работает при удержании и на заблокированном экране, bindl — на заблокированном.
bindel = , XF86AudioRaiseVolume, exec, wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+
bindel = , XF86AudioLowerVolume, exec, wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindl = , XF86AudioMute, exec, wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindl = , XF86AudioMicMute, exec, wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
bindel = , XF86MonBrightnessUp, exec, brightnessctl -e4 -n2 set 5%+
bindel = , XF86MonBrightnessDown, exec, brightnessctl -e4 -n2 set 5%-
bindl = , XF86AudioPlay, exec, playerctl play-pause
bindl = , XF86AudioPause, exec, playerctl play-pause
bindl = , XF86AudioNext, exec, playerctl next
bindl = , XF86AudioPrev, exec, playerctl previous

bindm = $mod, mouse:272, movewindow
bindm = $mod, mouse:273, resizewindow

source = ~/.config/hypr/user.conf
