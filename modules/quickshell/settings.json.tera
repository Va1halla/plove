{#- Сгенерировано plove из райса. Настройки панели: Config.qml следит за
    этим файлом и применяет изменения сразу, без перезапуска. -#}
{%- set time = "HH:mm" %}{% if options.clock_seconds %}{% set time = "HH:mm:ss" %}{% endif %}
{
  "rice": {{ name | json_encode() }},
  "style": {{ options.style | json_encode() }},
  "side": {{ options.rail_side | json_encode() }},
  "left": {{ options.modules_left | json_encode() }},
  "center": {{ options.modules_center | json_encode() }},
  "right": {{ options.modules_right | json_encode() }},
  "workspaces": {{ options.workspace_count }},
  "time": {{ time | json_encode() }},
  "date": {{ options.clock_date }},
  "terminal": {{ run_in | json_encode() }},
  "wallpaper": {{ wallpaper | json_encode() }},
  "widgets": {{ widgets | json_encode() }},
  "notifications": {{ components.notifications | default(value="") == "qs-notifications" }},
  "desktop": {{ components.widgets | default(value="") == "qs-desktop" }},
  "lua": {{ hypr_lua }}
}
