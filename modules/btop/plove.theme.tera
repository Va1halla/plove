# Сгенерировано plove из райса «{{ name }}».
{%- if ansi | length == 16 %}{% set green = ansi.2.hex %}{% set yellow = ansi.3.hex %}{% set red = ansi.1.hex %}
{%- else %}{% set green = colors.accent.hex %}{% set yellow = colors.accent.hex %}{% set red = colors.accent.hex %}{% endif %}
theme[main_bg]="{{ colors.bg.hex }}"
theme[main_fg]="{{ colors.fg.hex }}"
theme[title]="{{ colors.fg.hex }}"
theme[hi_fg]="{{ colors.accent.hex }}"
theme[selected_bg]="{{ colors.surface.hex }}"
theme[selected_fg]="{{ colors.accent.hex }}"
theme[inactive_fg]="{{ colors.muted.hex }}"
theme[graph_text]="{{ colors.muted.hex }}"
theme[meter_bg]="{{ colors.surface.hex }}"
theme[proc_misc]="{{ colors.accent.hex }}"
theme[cpu_box]="{{ colors.accent.hex }}"
theme[mem_box]="{{ colors.accent.hex }}"
theme[net_box]="{{ colors.accent.hex }}"
theme[proc_box]="{{ colors.accent.hex }}"
theme[div_line]="{{ colors.surface.hex }}"
theme[temp_start]="{{ green }}"
theme[temp_mid]="{{ yellow }}"
theme[temp_end]="{{ red }}"
theme[cpu_start]="{{ green }}"
theme[cpu_mid]="{{ yellow }}"
theme[cpu_end]="{{ red }}"
theme[free_start]="{{ green }}"
theme[free_mid]="{{ green }}"
theme[free_end]="{{ green }}"
theme[cached_start]="{{ colors.accent.hex }}"
theme[cached_mid]="{{ colors.accent.hex }}"
theme[cached_end]="{{ colors.accent.hex }}"
theme[available_start]="{{ yellow }}"
theme[available_mid]="{{ yellow }}"
theme[available_end]="{{ yellow }}"
theme[used_start]="{{ red }}"
theme[used_mid]="{{ red }}"
theme[used_end]="{{ red }}"
theme[download_start]="{{ colors.accent.hex }}"
theme[download_mid]="{{ colors.accent.hex }}"
theme[download_end]="{{ colors.fg.hex }}"
theme[upload_start]="{{ green }}"
theme[upload_mid]="{{ green }}"
theme[upload_end]="{{ colors.fg.hex }}"
theme[process_start]="{{ colors.accent.hex }}"
theme[process_mid]="{{ yellow }}"
theme[process_end]="{{ red }}"
