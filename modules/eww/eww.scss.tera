// Сгенерировано plove из райса «{{ name }}». Перезаписывается при `plove apply`.
{%- macro px(n, s) %}{% set v = n * s %}{{ v | round }}px{% endmacro px %}

* {
  all: unset;
}

window {
  background-color: transparent;
}

.desktop {
  font-family: "{{ fonts.ui }}", "{{ icon_font }}", "{{ fonts.mono }}";
  color: {{ colors.fg.hex }};
}

.card {
  padding: {{ style.pad }}px {{ style.pad * 2 }}px;
{%- if style.glass != "none" %}
  background-color: rgba({{ colors.bg.rgb }}, {{ style.bg_alpha - 0.25 }});
  border-radius: {{ style.radius_box }}px;
{%- endif %}
}

.clock {
  background-color: transparent;
}

.time {
  font-size: {{ options.clock_size }}px;
  font-weight: bold;
  color: {{ colors.accent.hex }};
  text-shadow: 0 4px 16px rgba({{ colors.bg.rgb }}, 0.6);
}

.date {
  font-size: {{ (options.clock_size / 5) | round }}px;
  margin-top: -8px;
  /* Дата цвета текста: на светлых обоях без тени её не видно. */
  text-shadow: 0 1px 6px rgba({{ colors.bg.rgb }}, 0.9), 0 0 2px rgba({{ colors.bg.rgb }}, 0.6);
}

.ring {
  min-width: 64px;
  min-height: 64px;
  color: {{ colors.accent.hex }};
  background-color: {{ colors.surface.hex }};
}

.ring-text {
  font-family: "{{ fonts.mono }}";
  font-size: 15px;
}

.ring-label,
.song {
  margin-top: 6px;
  color: {{ colors.muted.hex }};
}

.buttons button {
  font-size: 22px;
  color: {{ colors.fg.hex }};
}

.buttons button:hover {
  color: {{ colors.accent.hex }};
}
{% for id, w in widgets %}
.w_{{ id }} {
  color: {{ w.color }};
  font-size: 16px;
}
{%- endfor %}
{%- if desk | length > 0 %}

// Карточки из plove studio. Размеры шрифтов умножены на scale карточки.
.k_clock {
  background-color: transparent;
}

.zone,
.desc,
.artist,
.ring-label {
  color: {{ colors.muted.hex }};
}

.zone-time,
.temp,
.days,
.weather-icon {
  color: {{ colors.accent.hex }};
  font-weight: bold;
}

.cover {
  background-size: cover;
  background-position: center;
  border-radius: {{ style.radius_chip }}px;
}

.cal {
  padding: 4px;
}

.cal:selected {
  color: {{ colors.bg.hex }};
  background-color: {{ colors.accent.hex }};
  border-radius: {{ style.radius_chip }}px;
}

.cal.header,
.cal.button {
  color: {{ colors.accent.hex }};
}

.cal:indeterminate {
  color: {{ colors.muted.hex }};
}
{%- for c in desk %}
{%- set s = c.scale %}

.c{{ c.index }} {
  padding: {{ self::px(n=style.pad, s=s) }} {{ self::px(n=style.pad * 2, s=s) }};
  font-size: {{ self::px(n=15, s=s) }};
}
{%- if c.kind == "clock" %}
.c{{ c.index }} .time { font-size: {{ self::px(n=96, s=s) }}; }
.c{{ c.index }} .date { font-size: {{ self::px(n=20, s=s) }}; margin-top: {{ self::px(n=-6, s=s) }}; }
{%- elif c.kind == "worldclock" %}
.c{{ c.index }} .zone { font-size: {{ self::px(n=17, s=s) }}; }
.c{{ c.index }} .zone-time { font-size: {{ self::px(n=22, s=s) }}; font-family: "{{ fonts.mono }}"; }
{%- elif c.kind == "calendar" %}
.c{{ c.index }} .cal { font-size: {{ self::px(n=14, s=s) }}; }
{%- elif c.kind == "system" %}
.c{{ c.index }} .ring { min-width: {{ self::px(n=64, s=s) }}; min-height: {{ self::px(n=64, s=s) }}; }
.c{{ c.index }} .ring-text { font-size: {{ self::px(n=15, s=s) }}; }
.c{{ c.index }} .ring-label { font-size: {{ self::px(n=13, s=s) }}; }
{%- elif c.kind == "player" %}
.c{{ c.index }} .song { font-size: {{ self::px(n=18, s=s) }}; color: {{ colors.fg.hex }}; margin-top: 0; }
.c{{ c.index }} .artist { font-size: {{ self::px(n=14, s=s) }}; }
.c{{ c.index }} .buttons button { font-size: {{ self::px(n=22, s=s) }}; }
{%- elif c.kind == "weather" %}
.c{{ c.index }} .weather-icon { font-size: {{ self::px(n=48, s=s) }}; }
.c{{ c.index }} .temp { font-size: {{ self::px(n=30, s=s) }}; }
.c{{ c.index }} .desc { font-size: {{ self::px(n=14, s=s) }}; }
{%- elif c.kind == "countdown" %}
.c{{ c.index }} .days { font-size: {{ self::px(n=46, s=s) }}; }
.c{{ c.index }} .desc { font-size: {{ self::px(n=14, s=s) }}; }
{%- elif c.kind == "note" %}
.c{{ c.index }} .note { font-size: {{ self::px(n=17, s=s) }}; }
{%- elif c.kind == "widget" %}
.c{{ c.index }} label { font-size: {{ self::px(n=18, s=s) }}; }
{%- endif %}
{%- endfor %}
{%- endif %}
