# Сгенерировано plove из райса «{{ name }}».
# Этот файл перезаписывается при каждом `plove apply`.

general {
    # Не запускать второй экран блокировки поверх первого.
    lock_cmd = pidof hyprlock || {{ apps.lock | default(value="hyprlock") }}
    before_sleep_cmd = loginctl lock-session
    after_sleep_cmd = {{ hyprctl.dpms_on }}
}

listener {
    timeout = {{ options.lock_after * 60 }}
    on-timeout = loginctl lock-session
}

listener {
    timeout = {{ options.screen_off_after * 60 }}
    on-timeout = {{ hyprctl.dpms_off }}
    on-resume = {{ hyprctl.dpms_on }}
}
