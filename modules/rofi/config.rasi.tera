/* Сгенерировано plove из райса «{{ name }}». Перезаписывается при `plove apply`. */

configuration {
    modi: "drun,run,window";
    show-icons: {{ options.icons }};
    display-drun: "";
    display-run: "";
    display-window: "";
    drun-display-format: "{name}";
{%- if apps.terminal %}
    terminal: "{{ apps.terminal }}";
{%- endif %}
}

* {
    bg: {{ colors.bg.hex }}f2;
    bg-alt: {{ colors.surface.hex }};
    fg: {{ colors.fg.hex }};
    muted: {{ colors.muted.hex }};
    accent: {{ colors.accent.hex }};
    background-color: transparent;
    text-color: @fg;
    font: "{{ fonts.ui }} {{ fonts.size + 2 }}";
}

window {
    width: {{ options.width }}%;
    background-color: @bg;
    border: {{ style.border }}px;
    border-color: @accent;
    border-radius: {{ style.radius_box }}px;
    padding: 18px;
}

mainbox { spacing: 12px; children: [ inputbar, listview ]; }

inputbar {
    background-color: @bg-alt;
    border-radius: {{ style.radius_chip_px }}px;
    padding: 10px 14px;
    spacing: 10px;
    children: [ prompt, entry ];
}

prompt { text-color: @accent; }
entry { placeholder: "Поиск…"; placeholder-color: @muted; }

listview { lines: {{ options.lines }}; spacing: 4px; scrollbar: false; }

element {
    padding: 8px 12px;
    border-radius: {{ style.radius_chip_px }}px;
    spacing: 12px;
}
element-icon { size: 24px; }
/* Состояния пишем полностью (normal.normal, alternate.normal…): у rofi 2
   встроенная тема задаёт их отдельно, и без этого пункты были светлыми
   плашками, а выбранный — не цвета акцента. */
element normal.normal,
element alternate.normal,
element normal.active,
element alternate.active { background-color: transparent; text-color: @fg; }
element normal.urgent,
element alternate.urgent { background-color: transparent; text-color: @accent; }
element selected.normal,
element selected.active,
element selected.urgent { background-color: @accent; text-color: @bg; }
element-text { text-color: inherit; vertical-align: 0.5; }
