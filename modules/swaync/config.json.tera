{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "right",
  "positionY": "top",
  "control-center-margin-top": {{ geometry.gaps }},
  "control-center-margin-bottom": {{ geometry.gaps }},
  "control-center-margin-right": {{ geometry.gaps }},
  "control-center-width": 380,
  "notification-window-width": 380,
  "timeout": 5,
  "timeout-low": 3,
  "timeout-critical": 0,
  "fit-to-screen": true,
  "widgets": ["title", "dnd", "mpris", "notifications"],
  "widget-config": {
    "title": { "text": "Уведомления", "clear-all-button": true, "button-text": "Очистить" },
    "dnd": { "text": "Не беспокоить" },
    "mpris": { "image-size": 64, "image-radius": {{ style.radius_chip_px }} }
  }
}
