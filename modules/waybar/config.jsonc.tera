// Сгенерировано plove из райса «{{ name }}». Перезаписывается при `plove apply`.
{%- macro module_name(m) -%}
{%- if m == "workspaces" -%}hyprland/workspaces
{%- elif m == "window" -%}hyprland/window
{%- elif m == "language" -%}hyprland/language
{%- elif m == "media" -%}mpris
{%- elif m == "power" or m == "launcher" or m == "calculator" or m in widgets -%}custom/{{ m }}
{%- else -%}{{ m }}{%- endif -%}
{%- endmacro module_name %}
{#- Список модулей части панели; между ними — разделители custom/sep#<часть><номер>. -#}
{%- macro module_list(list, side) -%}
[{% for m in list %}"{{ self::module_name(m=m) }}"{% if not loop.last %}, {% if style.separators != "none" %}"custom/sep#{{ side }}{{ loop.index }}", {% endif %}{% endif %}{% endfor %}]
{%- endmacro module_list %}
{#- Подпись в стиле райса: значок, слово или оба. -#}
{#- На вертикальной панели места мало: только значок. -#}
{%- macro label(compact, glyph, word, value) -%}
{%- if compact and glyph != "" -%}{{ glyph }}
{%- elif style.labels == "glyphs" -%}{{ glyph }} {{ value }}
{%- elif style.labels == "text" -%}{{ word }} {{ value }}
{%- else -%}{{ glyph }} {{ word }} {{ value }}{%- endif -%}
{%- endmacro label %}
{#- Щелчок, открывающий выпадающее меню (модуль popups) под модулем панели.
    Якорь — край экрана у панели и та часть панели, где стоит модуль. -#}
{%- macro popup(menu, m, left, center, position) -%}
{%- if m in left %}{% set part = 0 %}{% elif m in center %}{% set part = 1 %}{% else %}{% set part = 2 %}{% endif %}
{%- if position == "left" or position == "right" -%}
{%- set h = position %}{% set v = ["top", "center", "bottom"] | nth(n=part) %}
{%- else -%}
{%- set v = position %}{% set h = ["left", "center", "right"] | nth(n=part) %}
{%- endif -%}
{%- if h == "center" %}{% set x = 0 %}{% else %}{% set x = geometry.gaps %}{% endif -%}
{%- if v == "center" %}{% set y = 0 %}{% else %}{% set y = geometry.gaps %}{% endif -%}
sh ~/.local/share/plove/popups.sh toggle {{ menu }} '{% if v == "center" and h == "center" %}center{% else %}{{ v }} {{ h }}{% endif %}' {{ x }}x{{ y }}
{%- endmacro popup %}
{%- set popups = apps.popups | default(value="") != "" %}
{%- set floats = style.bar != "solid" or options.floating %}
{#- Модули, которые waybar прячет, когда показывать нечего. #}
{%- set hideable = ["media", "battery", "backlight", "tray"] %}
{%- set date = "" %}{% if options.clock_date %}{% set date = "%d.%m  " %}{% endif %}
{%- set seconds = "" %}{% if options.clock_seconds %}{% set seconds = ":%S" %}{% endif %}
{%- set clock = "{:" ~ date ~ "%H:%M" ~ seconds ~ "}" %}
{#- Панели: первая — из настроек выше, остальные — из списка bars. #}
[
{%- set count = options.bars | length %}
{%- for i in range(end=count + 1) %}
{%- if i == 0 %}
{%- set position = options.position %}{% set outputs = options.monitors %}
{%- set left = options.modules_left %}{% set center = options.modules_center %}{% set right = options.modules_right %}
{%- else %}
{%- set j = i - 1 %}{% set b = options.bars[j] %}
{%- set position = b.position | default(value="top") %}{% set outputs = b.monitors | default(value=[]) %}
{%- set left = b.left | default(value=[]) %}{% set center = b.center | default(value=[]) %}{% set right = b.right | default(value=[]) %}
{%- endif %}
{%- set vertical = position == "left" or position == "right" %}
{%- if vertical %}{% set bar_clock = "{:%H\n%M}" %}{% else %}{% set bar_clock = clock %}{% endif %}
  {
    "layer": "top",
{%- if outputs | length > 0 %}
    "output": [{% for o in outputs %}"{{ o }}"{% if not loop.last %}, {% endif %}{% endfor %}],
{%- endif %}
    "position": "{{ position }}",
{%- if vertical %}
    "width": {{ style.bar_height + 12 }},
{%- else %}
    "height": {{ style.bar_height }},
{%- endif %}
{%- if floats %}
{%- if position == "bottom" %}
    "margin": "0 {{ geometry.gaps }} {{ geometry.gaps }} {{ geometry.gaps }}",
{%- elif position == "left" %}
    "margin": "{{ geometry.gaps }} 0 {{ geometry.gaps }} {{ geometry.gaps }}",
{%- elif position == "right" %}
    "margin": "{{ geometry.gaps }} {{ geometry.gaps }} {{ geometry.gaps }} 0",
{%- else %}
    "margin": "{{ geometry.gaps }} {{ geometry.gaps }} 0 {{ geometry.gaps }}",
{%- endif %}
{%- endif %}
    "spacing": {{ style.pad_small }},
    "modules-left": {{ self::module_list(list=left, side="l") }},
    "modules-center": {{ self::module_list(list=center, side="c") }},
    "modules-right": {{ self::module_list(list=right, side="r") }},
{% for side in ["l", "c", "r"] %}
{%- if side == "l" %}{% set list = left %}{% set glyph = style.sep_left %}
{%- elif side == "c" %}{% set list = center %}{% set glyph = style.sep_center %}
{%- else %}{% set list = right %}{% set glyph = style.sep_right %}{% endif %}
{#- Стрелки, наклоны и линии смотрят вбок; на вертикальной панели — черта поперёк. #}
{%- if vertical and style.separators != "dots" %}{% set glyph = "─" %}{% endif %}
{%- if style.separators != "none" %}{% for m in list %}{% if not loop.last %}
{#- Разделитель перед list[n]. Если рядом модули, которые waybar прячет,
    разделитель показывается, только когда с обеих сторон что-то видно. -#}
{%- set n = loop.index %}
{%- set_global all_hide = true %}
{%- for p in list | slice(end=n) %}{% if p not in hideable %}{% set_global all_hide = false %}{% endif %}{% endfor %}
{%- if list[n] in hideable or all_hide %}
    "custom/sep#{{ side }}{{ n }}": {
      "format": "{{ glyph }}",
      "exec": "sh ~/.local/share/plove/waybar-sep.sh {{ n }} {{ list | join(sep=" ") }}",
      "interval": 5,
      "tooltip": false
    },
{%- else %}
    "custom/sep#{{ side }}{{ n }}": { "format": "{{ glyph }}", "tooltip": false },
{%- endif %}
{%- endif %}{% endfor %}{% endif %}
{%- endfor %}

    "hyprland/workspaces": {
      "format": "{id}"
{%- if options.workspace_count > 0 %},
      "persistent-workspaces": { "*": {{ options.workspace_count }} }
{%- endif %}
    },
    "hyprland/window": { "max-length": {{ options.window_length }}, "separate-outputs": true{% if vertical %}, "rotate": 90{% endif %} },
    "hyprland/language": { "format": "{{ self::label(compact=vertical, glyph="󰌌", word="", value="{short}") }}" },
    "clock": {
{%- if popups %}
      "on-click": {{ self::popup(menu="clock", m="clock", left=left, center=center, position=position) | json_encode() }},
{%- endif %}
{%- if options.clock_seconds %}
      "interval": 1,
{%- endif %}
      "format": "{% if vertical %}{{ bar_clock }}{% else %}{{ self::label(compact=false, glyph="󰅐", word="", value=bar_clock) | trim }}{% endif %}",
      "tooltip-format": "<big>{:%d.%m.%Y}</big>\n<tt>{calendar}</tt>"
    },
    "cpu": { "format": "{{ self::label(compact=vertical, glyph="󰻠", word="cpu", value="{usage}%") }}", "interval": 3 },
    "memory": { "format": "{{ self::label(compact=vertical, glyph="󰍛", word="ram", value="{percentage}%") }}", "interval": 5 },
    "backlight": { "format": "{{ self::label(compact=vertical, glyph="󰃟", word="свет", value="{percent}%") }}" },
    "battery": {
      "format": "{{ self::label(compact=vertical, glyph="{icon}", word="бат", value="{capacity}%") }}",
      "format-charging": "{{ self::label(compact=vertical, glyph="󰂄", word="заряд", value="{capacity}%") }}",
      "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰂂", "󰁹"],
      "states": { "warning": 25, "critical": 10 }
    },
    "network": {
      "format-wifi": "{{ self::label(compact=vertical, glyph="󰖩", word="", value="{essid}") | trim }}",
      "format-ethernet": "{{ self::label(compact=vertical, glyph="󰈀", word="", value="eth") | trim }}",
      "format-disconnected": "{{ self::label(compact=vertical, glyph="󰖪", word="", value="offline") | trim }}",
      "tooltip-format": "{ipaddr}"{% if popups %},
      "on-click": {{ self::popup(menu="network", m="network", left=left, center=center, position=position) | json_encode() }}{% endif %}
    },
    "pulseaudio": {
      "format": "{{ self::label(compact=vertical, glyph="{icon}", word="vol", value="{volume}%") }}",
      "format-muted": "{{ self::label(compact=vertical, glyph="󰖁", word="vol", value="muted") }}",
      "format-icons": { "default": ["󰕿", "󰖀", "󰕾"] },
{%- if popups %}
      "on-click": {{ self::popup(menu="volume", m="pulseaudio", left=left, center=center, position=position) | json_encode() }},
      "on-click-middle": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
      "on-click-right": "sh ~/.local/share/plove/popups.sh mixer"
{%- else %}
      "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
{%- endif %}
    },
    "mpris": { "format": "{{ self::label(compact=vertical, glyph="󰝚", word="", value="{artist} — {title}") | trim }}", "max-length": 40 },
    "tray": { "spacing": {{ style.pad }} },
{%- for id, w in widgets %}
{%- set text = w.text | replace(from="{value}", to="{}") %}
{%- if vertical and w.icon != "" %}{% set text = w.icon %}
{%- elif w.icon != "" and style.labels != "text" %}{% set text = w.icon ~ " " ~ text %}{% endif %}
    "custom/{{ id }}": {
      "exec": {{ w.command | json_encode() }},
      "interval": {{ w.every }},
      "format": {{ text | json_encode() }},
{%- if w.click %}
      "on-click": {{ w.click | json_encode() }},
{%- endif %}
      "tooltip": false
    },
{%- endfor %}
    "custom/launcher": {
      "format": "{% if style.labels == "text" %}apps{% else %}{% endif %}",
      "on-click": "{{ apps.launcher | default(value="") | replace(from='"', to='\\"') }}",
      "tooltip": false
    },
    "custom/calculator": {
      "format": "{{ self::label(compact=vertical, glyph="󰃬", word="calc", value="") | trim }}",
{%- if popups %}
      "on-click": {{ self::popup(menu="calculator", m="calculator", left=left, center=center, position=position) | json_encode() }},
{%- else %}
{%- set qalc = run_in ~ " qalc" %}
      "on-click": {{ qalc | trim | json_encode() }},
{%- endif %}
      "tooltip": false
    },
    "custom/power": {
      "format": "{% if style.labels == "text" %}off{% else %}󰐥{% endif %}",
      "on-click": "{{ apps.power | default(value="") | replace(from='"', to='\\"') }}",
      "tooltip": false
    }
  }{% if not loop.last %},{% endif %}
{%- endfor %}
]
