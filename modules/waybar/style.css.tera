/* Сгенерировано plove из райса «{{ name }}». Перезаписывается при `plove apply`. */
{%- set floats = style.bar != "solid" or options.floating %}
{%- set panel_bg = "rgba(" ~ colors.bg.rgb ~ ", " ~ style.bg_alpha ~ ")" %}
{#- Фон панели (настройка background). alpha() и mix() — функции CSS в GTK. -#}
{%- set a = style.bg_alpha %}
{%- set magenta = colors.accent.hex %}{% if ansi | length == 16 %}{% set magenta = ansi.5.hex %}{% endif %}
{%- set c1 = options.background_color | default(value="") %}
{%- set c2 = options.background_color2 | default(value="") %}
{%- if c1 == "" %}{% set c1 = "mix(" ~ colors.bg.hex ~ ", " ~ colors.accent.hex ~ ", 0.35)" %}{% endif %}
{%- if c2 == "" %}{% set c2 = "mix(" ~ colors.bg.hex ~ ", " ~ magenta ~ ", 0.35)" %}{% endif %}
{%- set image = "" %}
{%- if options.background == "wallpaper" %}{% set image = wallpaper %}
{%- elif options.background == "image" %}{% set image = options.background_image | default(value="") %}{% endif %}
{%- if image is starting_with("~/") %}{% set rest = image | trim_start_matches(pat="~") %}{% set image = home ~ rest %}{% endif %}
{%- if options.background == "tint" %}{% set panel_bg = "alpha(mix(" ~ colors.bg.hex ~ ", " ~ colors.accent.hex ~ ", 0.22), " ~ a ~ ")" %}
{%- elif options.background == "gradient" %}{% set panel_bg = "linear-gradient(90deg, alpha(" ~ c1 ~ ", " ~ a ~ "), alpha(" ~ c2 ~ ", " ~ a ~ "))" %}
{%- elif options.background == "color" and options.background_color %}{% set panel_bg = "alpha(" ~ options.background_color ~ ", " ~ a ~ ")" %}
{%- endif %}
{%- macro panel_background(panel_bg, image) %}
    background: {{ panel_bg }};
{%- if image != "" %}
    /* Картинка поверх цвета: если файла нет, виден цвет. Сверху её
       притеняет фон темы, чтобы подписи читались на любой картинке. */
    background-image: linear-gradient(alpha({{ colors.bg.hex }}, 0.45), alpha({{ colors.bg.hex }}, 0.45)), url("{{ image }}");
    background-size: cover;
    background-position: center;
{%- endif %}
{%- endmacro panel_background %}

* {
    /* Моноширинный Nerd Font — запасной: из него берутся значки. */
    font-family: "{{ fonts.ui }}", "{{ fonts.mono }}";
    font-size: {{ fonts.size }}pt;
    border: none;
    min-height: 0;
}

window#waybar {
{%- if style.bar == "solid" or style.bar == "floating" %}
{{- self::panel_background(panel_bg=panel_bg, image=image) }}
{%- else %}
    background: transparent;
{%- endif %}
    color: {{ colors.fg.hex }};
{%- if style.bar == "floating" or (style.bar == "solid" and floats) %}
    border-radius: {{ style.radius_box }}px;
{%- if style.border > 0 %}
    border: {{ style.border }}px solid {{ colors.surface.hex }};
{%- endif %}
{%- endif %}
}

{%- if style.bar == "islands" %}

/* Острова: каждая часть панели в своей плашке. */
.modules-left,
.modules-center,
.modules-right {
{{- self::panel_background(panel_bg=panel_bg, image=image) }}
    border-radius: {% if style.shape == "pill" %}999{% else %}{{ style.radius_box }}{% endif %}px;
    padding: 0 {{ style.pad_small }}px;
{%- if style.border > 0 %}
    border: {{ style.border }}px solid {{ colors.surface.hex }};
{%- endif %}
}
{%- endif %}

/* Вертикальная панель: отступы сверху и снизу, а не по бокам, иначе
   крайние модули прилипают к краю панели. */
window#waybar.left .modules-left,
window#waybar.left .modules-center,
window#waybar.left .modules-right,
window#waybar.right .modules-left,
window#waybar.right .modules-center,
window#waybar.right .modules-right {
    padding: {{ style.pad_small }}px 0;
}

#workspaces button {
    padding: 0 {{ style.pad }}px;
    margin: {{ (style.pad_small / 2) | round(method="floor") }}px 1px;
    color: {{ colors.muted.hex }};
    background: transparent;
    border-radius: {{ style.radius_chip }}px;
}

#workspaces button.active {
    color: {{ colors.bg.hex }};
    background: {{ colors.accent.hex }};
}

#workspaces button:hover {
    background: {{ colors.surface.hex }};
    color: {{ colors.fg.hex }};
}

#window,
#language,
#clock,
#cpu,
#memory,
#backlight,
#battery,
#network,
#pulseaudio,
#mpris,
#tray,
#custom-launcher,
#custom-power {
    padding: 0 {{ style.pad }}px;
    border-radius: {{ style.radius_chip }}px;
}

#clock,
#custom-launcher {
    color: {{ colors.accent.hex }};
}

#custom-launcher {
    font-size: {{ fonts.size + 3 }}pt;
}

#custom-power {
    color: {% if ansi | length == 16 %}{{ ansi.1.hex }}{% else %}{{ colors.accent.hex }}{% endif %};
}

#custom-sep {
    /* Только Nerd Font: в Inter и других шрифтах интерфейса на тех же
       кодах (U+E0B0–E0BF) свои значки, и вместо стрелок выходил мусор. */
    font-family: "{{ fonts.mono }}";
    color: {{ colors.surface.hex }};
    padding: 0 2px;
}

#battery.warning {
    color: {% if ansi | length == 16 %}{{ ansi.3.hex }}{% else %}{{ colors.accent.hex }}{% endif %};
}

#battery.critical,
#pulseaudio.muted {
    color: {% if ansi | length == 16 %}{{ ansi.1.hex }}{% else %}{{ colors.muted.hex }}{% endif %};
}

tooltip {
    background: {{ colors.bg.hex }};
    border: 1px solid {{ colors.surface.hex }};
    border-radius: {{ style.radius_box }}px;
}
{% for id, w in widgets %}
#custom-{{ id }} {
    color: {{ w.color }};
    padding: 0 {{ style.pad }}px;
}
{%- endfor %}
